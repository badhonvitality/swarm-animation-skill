{
  "name": "@badhonvitality/swarm-animation-skill",
  "version": "1.0.1",
  "description": "Reusable AI agent skill for React swarm animations, autonomous cursors, mouse interactions and particle physics.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./styles.css": "./src/styles/global.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync-skills": "node scripts/sync-skills.js",
    "validate": "node scripts/validate-skill.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badhonvitality/swarm-animation-skill.git"
  },
  "keywords": [
    "react",
    "ai-agent",
    "agent-skills",
    "swarm-animation",
    "mouse-animation",
    "cursor-animation",
    "particle-physics",
    "canvas",
    "open-source"
  ],
  "author": "badhonvitality",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11"
  }
}
